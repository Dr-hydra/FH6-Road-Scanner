<Window x:Class="StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描状态"
        Width="330"
        Height="132"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="PanOverlay"
            Margin="10"
            CornerRadius="10"
            Background="#F2FFFFFF"
            BorderBrush="#661370F3"
            BorderThickness="1"
            Padding="16,13">
        <Border.Effect>
            <DropShadowEffect Color="#55000000"
                              BlurRadius="14"
                              ShadowDepth="3"
                              Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StateDot"
                             Width="9"
                             Height="9"
                             Fill="#1370F3"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock x:Name="LabOverlayState"
                               Text="扫描准备中"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#343D4A"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1"
                        CornerRadius="5"
                        Background="#E6EAF2FE"
                        Padding="9,4"
                        Margin="12,0,0,0">
                    <TextBlock x:Name="LabOverlayHotkeys"
                               Text="F7 开始 / F8 停止"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#0B5BCB" />
                </Border>
            </Grid>

            <TextBlock Grid.Row="1"
                       x:Name="LabOverlayStatus"
                       Text="正在连接扫描后端……"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12"
                       Foreground="#737373"
                       Margin="17,8,0,8" />

            <Grid Grid.Row="2">
                <ProgressBar x:Name="OverlayProgress"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             VerticalAlignment="Center" />
                <TextBlock x:Name="LabOverlayProgress"
                           Text="0%"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#737373"
                           Background="#F2FFFFFF"
                           Padding="6,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
